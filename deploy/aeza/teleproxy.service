[Unit]
Description=Teleproxy MTProto (multi-user, via Xray socks)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Путь и лимиты под сервер; на роутере лимиты задавались init-скриптом.
ExecStart=/opt/teleproxy/teleproxy --config /opt/teleproxy/config.toml --msg-buffers-size 134217728 --connections 4096 --max-special-connections 1024
Restart=always
RestartSec=3
LimitNOFILE=262144

[Install]
WantedBy=multi-user.target
