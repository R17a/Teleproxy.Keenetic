[Unit]
Description=Teleproxy MTProto multi-user (VDS, direct outbound)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/teleproxy
ExecStart=/opt/teleproxy/teleproxy --config /opt/teleproxy/config.toml --msg-buffers-size 67108864 --connections 4096 --max-special-connections 1024
Restart=always
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
