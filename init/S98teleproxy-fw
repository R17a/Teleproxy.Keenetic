#!/bin/sh
# S98teleproxy-fw — проброс порта MTProxy (8443) на роутер.
#
# iptables не переживает перезагрузку, а WAN (ppp0) на Keenetic поднимается
# ПОЗЖЕ старта init-скриптов — одноразовая попытка на загрузке часто опаздывает,
# и порт остаётся закрытым (INPUT policy DROP). Поэтому:
#   * start — ставит правила сейчас и запускает фоновый наблюдатель;
#   * наблюдатель раз в 20 с проверяет наличие правил и восстанавливает их
#     (ловит поздний WAN, реконнект PPPoE, пересборку правил NDM);
#   * stop — снимает правила и гасит наблюдатель.
#
# Внешний порт 8443 → localhost:8443 + ACCEPT в INPUT. Для LAN — по внешнему IP,
# чтобы ссылка работала и из WiFi. Порт 443 не трогаем: там ocserv/nginx.

PORT=8443
STATS_PORT=8899
# Запасное значение, если размер пула не удалось прочитать из cmdline процесса.
# Держать равным --msg-buffers-size из S99teleproxy (иначе проценты занятости
# считаются от чужого знаменателя и сторож срабатывает не вовремя).
POOL_DEFAULT=8388608
PIDFILE=/opt/var/run/teleproxy-fw.pid
LOG=/opt/var/log/teleproxy-fw.log
XRAY_TS=/opt/var/run/xray-mem-restart.ts

say() { echo "[teleproxy-fw] $*"; }

# Приоритеты OOM: чем меньше, тем позже ядро убьёт процесс.
set_oom_prio() {
    for _p in $(pidof autossh 2>/dev/null) $(pidof ssh 2>/dev/null); do
        echo -900 > "/proc/$_p/oom_score_adj" 2>/dev/null || true
    done
    for _p in $(pidof teleproxy 2>/dev/null); do
        echo -500 > "/proc/$_p/oom_score_adj" 2>/dev/null || true
    done
    for _p in $(pidof xray 2>/dev/null); do
        echo 300 > "/proc/$_p/oom_score_adj" 2>/dev/null || true
    done
}

# Фиксатор падений Xray. Наблюдение 2026-11-09: Xray пропадал в 20:52 и 21:26,
# но ни его лог, ни dmesg причины не сохраняли — файлы пересоздаются при старте,
# и улика стирается раньше, чем её прочитаешь. Здесь снимаем состояние в тот
# момент, когда процесс уже пропал, а сторож Susanin его ещё не поднял.
capture_xray_crash() {
    if [ -n "$(pidof xray 2>/dev/null)" ]; then
        _xray_down=0
        return 0
    fi
    [ "$_xray_down" -eq 1 ] && return 0
    _xray_down=1
    _cf=/opt/var/log/xray-crash.log
    # не даём файлу расти бесконечно: держим последние ~500 строк
    if [ -f "$_cf" ] && [ "$(wc -l < "$_cf" 2>/dev/null || echo 0)" -gt 800 ]; then
        tail -500 "$_cf" > "$_cf.tmp" 2>/dev/null && mv -f "$_cf.tmp" "$_cf"
    fi
    {
        echo "=== $(date '+%F %T') Xray пропал ==="
        echo "--- load/uptime ---"; cat /proc/loadavg; uptime
        echo "--- mem ---"; grep -E "^(MemFree|MemAvailable|Cached|Slab):" /proc/meminfo
        echo "--- ps (xray) ---"; ps w | grep "[x]ray"
        echo "--- xray.log (S93) ---"; tail -25 /opt/susanin/var/xray.log 2>/dev/null
        echo "--- /tmp/xray.log (движок) ---"; tail -25 /tmp/xray.log 2>/dev/null
        echo "--- dmesg tail ---"; dmesg 2>/dev/null | tail -12
        echo
    } >> "$_cf" 2>&1
}

wan_if() {
    ip route show default 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -1
}
ext_ip() {
    ip route get 8.8.8.8 2>/dev/null | awk '{for (i=1;i<=NF;i++) if ($i=="src") { print $(i+1); exit }}'
}

apply_rules() {
    WAN=$(wan_if)
    [ -n "$WAN" ] && [ "$WAN" != "link" ] || return 1

    iptables -w -t nat -C PREROUTING -i "$WAN" -p tcp --dport "$PORT" \
        -j REDIRECT --to-ports "$PORT" 2>/dev/null || \
    iptables -w -t nat -I PREROUTING 1 -i "$WAN" -p tcp --dport "$PORT" \
        -j REDIRECT --to-ports "$PORT" 2>/dev/null || return 1

    iptables -w -C INPUT -i "$WAN" -p tcp --dport "$PORT" -j ACCEPT 2>/dev/null || \
    iptables -w -I INPUT 1 -i "$WAN" -p tcp --dport "$PORT" -j ACCEPT 2>/dev/null || true

    EXT=$(ext_ip)
    if [ -n "$EXT" ]; then
        for IF in br0 br1; do
            iptables -w -t nat -C PREROUTING -i "$IF" -p tcp -d "$EXT" --dport "$PORT" \
                -j REDIRECT --to-ports "$PORT" 2>/dev/null || \
            iptables -w -t nat -I PREROUTING 1 -i "$IF" -p tcp -d "$EXT" --dport "$PORT" \
                -j REDIRECT --to-ports "$PORT" 2>/dev/null || true
        done
    fi
    return 0
}

rules_ok() {
    WAN=$(wan_if)
    [ -n "$WAN" ] || return 1
    iptables -w -t nat -C PREROUTING -i "$WAN" -p tcp --dport "$PORT" \
        -j REDIRECT --to-ports "$PORT" 2>/dev/null || return 1
    iptables -w -C INPUT -i "$WAN" -p tcp --dport "$PORT" -j ACCEPT 2>/dev/null || return 1
    return 0
}

# Пул буферов телепрокси на Keenetic исчерпывается под нагрузкой (видео):
# в логе появляется "cannot allocate tcp receive buffer (got 0 of 128)",
# новые DC-подключения не открываются, и клиент висит на «Соединение».
# Само это не чинится — процесс жив, просто ему нечего выделить. Отдельный
# «зависший» сокет снаружи не закрыть (чужой fd без ptrace не отдать), поэтому
# лечим на уровне процесса: перезапускаем teleproxy, когда
#   * пул >= 95% три цикла подряд, либо
#   * пул >= 85% И за цикл не прочитано ни байта (tcp_readv_bytes не растёт)
#     три цикла подряд — это и есть залипшие соединения, держащие буферы.
# Нормальное видео под нагрузкой пул забивает, но байты при этом идут, так что
# его не трогаем.
STATE=/opt/var/run/teleproxy-fw.state

pool_size() {
    _p=$(pidof teleproxy 2>/dev/null | awk '{print $1}')
    [ -n "$_p" ] || return 1
    _pool=$(tr '\0' '\n' < "/proc/$_p/cmdline" 2>/dev/null | \
        awk '/^--msg-buffers-size$/ { getline; print; exit }')
    [ -n "$_pool" ] || _pool=$POOL_DEFAULT
    echo "$_pool"
}

watch_loop() {
    _hard=0
    _stuck=0
    _memlow=0
    _xray_down=0
    while :; do
        if ! rules_ok; then
            if apply_rules; then
                echo "[$(date '+%F %T')] правила восстановлены (wan=$(wan_if))" >>"$LOG"
            fi
        fi

        capture_xray_crash

        _pool=$(pool_size) || _pool=
        _vals=$(curl -s -m 3 "http://127.0.0.1:$STATS_PORT/stats" 2>/dev/null | \
            awk '/^allocated_buffer_bytes/ { u = $2 } /^tcp_readv_bytes/ { r = $2 } \
                 END { if (u != "") print u, (r == "" ? 0 : r) }')
        _used=${_vals% *}
        _rd=${_vals#* }

        if [ -n "$_pool" ] && [ -n "$_used" ] && [ "$_pool" -gt 0 ]; then
            _pct=$((_used * 100 / _pool))
            _prev=
            [ -f "$STATE" ] && _prev=$(cat "$STATE" 2>/dev/null)
            echo "$_rd" > "$STATE"

            # Перезапуск только если трафик реально встал. Высокий пул сам по
            # себе — не повод: в teleproxy есть обратное давление, при живом
            # трафике оно разгружает пул, а рестарт рвёт рабочие соединения
            # (именно из-за этого видео «замирало» на ровном месте).
            if [ "$_pct" -ge 95 ] && [ -n "$_prev" ] && [ "$_rd" -le "$_prev" ]; then
                _hard=$((_hard + 1))
            else
                _hard=0
            fi

            if [ "$_pct" -ge 85 ] && [ -n "$_prev" ] && [ "$_rd" -le "$_prev" ]; then
                _stuck=$((_stuck + 1))
                [ "$_stuck" -eq 1 ] && echo "[$(date '+%F %T')] пул ${_pct}%, трафик не идёт" >>"$LOG"
            else
                _stuck=0
            fi

            if [ "$_hard" -ge 2 ] || [ "$_stuck" -ge 3 ]; then
                echo "[$(date '+%F %T')] teleproxy залип (пул ${_pct}%, hard=$_hard stuck=$_stuck) — перезапуск" >>"$LOG"
                /opt/etc/init.d/S99teleproxy restart >>"$LOG" 2>&1 || true
                _hard=0
                _stuck=0
                rm -f "$STATE"
            fi
        fi

        # Приоритеты OOM. Наблюдение 2026-11-09 21:35: при нехватке памяти ядро
        # убило ssh-туннель (rss 15.5 МБ), autossh поднимал новый около минуты,
        # и всё это время Telegram висел без SOCKS5. Без правки ядро снова
        # выберет самый крупный процесс, а не самый безобидный.
        # ssh/autossh — защищаем сильнее всех: без них Teleproxy немой.
        # Xray — делаем первой жертвой: его возвращает S95xray-guard.
        set_oom_prio

        # Память. Раньше здесь перезапускался teleproxy — это оказалось вредно:
        # его RSS 4,6 МБ, перезапуск не освобождает почти ничего, зато рвёт все
        # соединения. Освобождать имеет смысл только Xray (rss ~8 МБ, HWM 19 МБ),
        # и не чаще раза в 30 минут, иначе получим цикл «упал-поднялся».
        _avail=$(awk '/MemAvailable/ { printf "%d", $2 / 1024 }' /proc/meminfo 2>/dev/null)
        if [ -n "$_avail" ] && [ "$_avail" -lt 10 ] 2>/dev/null; then
            _memlow=$((_memlow + 1))
            if [ "$_memlow" -eq 1 ]; then
                echo "[$(date '+%F %T')] LOWMEM ${_avail} МБ — слежу" >>"$LOG"
            fi
            if [ "$_memlow" -ge 3 ] && [ "$_avail" -lt 7 ] 2>/dev/null; then
                _now=$(date +%s)
                _last=0
                [ -f "$XRAY_TS" ] && _last=$(cat "$XRAY_TS" 2>/dev/null)
                case "$_last" in ''|*[!0-9]*) _last=0 ;; esac
                if [ $((_now - _last)) -ge 1800 ] && [ -x /opt/etc/init.d/S93xray-tproxy ]; then
                    echo "[$(date '+%F %T')] LOWMEM ${_avail} МБ — перезапуск Xray (teleproxy не трогаю: его RSS 4,6 МБ)" >>"$LOG"
                    /opt/etc/init.d/S93xray-tproxy restart >>"$LOG" 2>&1 || true
                    echo "$_now" > "$XRAY_TS" 2>/dev/null || true
                fi
                _memlow=0
            fi
        else
            _memlow=0
        fi

        sleep 20
    done
}

case "${1:-start}" in
    start)
        mkdir -p /opt/var/log /opt/var/run 2>/dev/null || true
        i=0
        while [ "$i" -lt 6 ]; do
            apply_rules && break
            i=$((i + 1))
            [ "$i" -lt 6 ] && sleep 5
        done
        if rules_ok; then
            say "порт $PORT проброшен (wan=$(wan_if))"
        else
            say "WAN ещё не готов — правила поставит наблюдатель"
        fi
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            exit 0
        fi
        nohup "$0" __watch >>"$LOG" 2>&1 &
        echo $! > "$PIDFILE"
        ;;
    __watch)
        watch_loop
        ;;
    stop)
        [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
        rm -f "$PIDFILE"
        WAN=$(wan_if)
        if [ -n "$WAN" ]; then
            iptables -w -t nat -D PREROUTING -i "$WAN" -p tcp --dport "$PORT" \
                -j REDIRECT --to-ports "$PORT" 2>/dev/null || true
            iptables -w -D INPUT -i "$WAN" -p tcp --dport "$PORT" -j ACCEPT 2>/dev/null || true
        fi
        EXT=$(ext_ip)
        if [ -n "$EXT" ]; then
            for IF in br0 br1; do
                iptables -w -t nat -D PREROUTING -i "$IF" -p tcp -d "$EXT" --dport "$PORT" \
                    -j REDIRECT --to-ports "$PORT" 2>/dev/null || true
            done
        fi
        say "правила сняты, наблюдатель остановлен"
        ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "наблюдатель: RUNNING pid $(cat "$PIDFILE")"
        else
            echo "наблюдатель: STOPPED"
        fi
        if rules_ok; then echo "правила: OK (wan=$(wan_if))"; else echo "правила: MISSING"; fi
        ;;
    *)
        echo "usage: $0 {start|stop|status}" >&2
        exit 1
        ;;
esac
