# Teleproxy на Keenetic (mipsel/aarch64/...).
# Слушаем 8443: 443 на роутере обычно занят ocserv/nginx (OC+ и веб-конфигуратор).
# Выход в интернет — один из двух (README.md, раздел «Выход в интернет»):
#   A) маршрут в туннель nwg («Другое подключение») задаёт Susanin.Keenetic
#      0.4.5+ по uid процесса: user = "teleproxy" + proxy_uid/proxy_egress;
#   B) socks5 = "socks5://127.0.0.1:1080" — через Xray из того же
#      Susanin.Keenetic, тогда user/proxy_uid/proxy_egress не нужны.

port = 8443
stats_port = 8899
http_stats = true
direct = true
# Работаем под отдельным пользователем: по нему Susanin.Keenetic матчит трафик.
# Пользователя создаёт postinst пакета (или вручную: adduser -S -D -H teleproxy).
user = "teleproxy"
workers = 0
# Потолок «special» (секретных) соединений. Общий лимит, число special и пул
# буферов на Keenetic задаёт init-скрипт, он перекрывает TOML:
#   S99teleproxy: --connections 128 --max-special-connections 32
#                 --msg-buffers-size 10485760   (5 чанков по 2 МБ)
# 4 МБ исчерпывались под нагрузкой, 8 МБ упирались под видео, 16 МБ давали
# kswapd/OOM; 10 МБ — рабочее значение.
max_connections = 32
# Автоматическая фрагментация ClientHello (низкий MSS). На PPPoE Keenetic с ней
# хуже — проверено, поэтому по умолчанию выключаем (postinst тоже это делает).
mss_clamp = false
domain = "cloudflare.com"

# Апстрим через SOCKS Xray (Reality) из Susanin.Keenetic: раскомментируйте,
# если Xray слушает 127.0.0.1:1080 — postinst включает это сам при установке.
# socks5 = "socks5://127.0.0.1:1080"

# Секрет: 32 hex-символа (16 байт). В примере ключ = hex(домена)
# (cloudflare.com → 636c6f7564666c6172652e636f6d), поэтому он заведомо
# демонстрационный. Свой ключ генерируйте случайным; блоков [[secret]] может
# быть несколько — по одному на пользователя/устройство.
[[secret]]
key = "636c6f7564666c6172652e636f6d"
label = "default"
