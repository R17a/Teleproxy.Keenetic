#!/bin/sh
# postinst — установка «под ключ», без ручных шагов на роутере:
#   1) пользователь teleproxy (запись в /etc/passwd — надёжнее busybox-adduser);
#   2) права на конфиг;
#   3) ключи P5 в susanin.conf + перезапуск Susanin (создаст правило метки);
#   4) проброс порта 8443 (S98teleproxy-fw: сейчас и при каждой загрузке).
#
# Важно: без пользователя teleproxy iptables -m owner --uid-owner teleproxy не
# ставится, метка не появляется, и трафик прокси идёт мимо туннеля
# (susanin check показывал mark_rules=0).
set -e

USER_NAME=teleproxy
USER_SHELL=/sbin/nologin
USER_HOME=/opt/var/empty
BASE_UID=1001

user_exists() { id -u "$USER_NAME" >/dev/null 2>&1; }

add_via_passwd() {
    [ -w /etc/passwd ] || return 1
    _uid=$BASE_UID
    while awk -F: -v u="$_uid" '$3==u {found=1} END {exit !found}' /etc/passwd 2>/dev/null; do
        _uid=$((_uid + 1))
    done
    grep -q "^${USER_NAME}:" /etc/passwd 2>/dev/null || \
        echo "${USER_NAME}:x:${_uid}:${_uid}::${USER_HOME}:${USER_SHELL}" >> /etc/passwd
    grep -q "^${USER_NAME}:" /etc/group 2>/dev/null || \
        echo "${USER_NAME}:x:${_uid}:" >> /etc/group
    user_exists
}

mkdir -p /opt/etc/teleproxy /opt/var/log /opt/var/run "$USER_HOME"

USER_OK=0
user_exists && USER_OK=1
# 1) прямая запись — предсказуемо на Keenetic (busybox adduser капризен)
[ "$USER_OK" = 1 ] || { add_via_passwd && USER_OK=1; }
# 2) штатные утилиты, если /etc/passwd недоступен для записи
[ "$USER_OK" = 1 ] || { adduser -S -D -H -s "$USER_SHELL" "$USER_NAME" >/dev/null 2>&1 && user_exists && USER_OK=1; }
[ "$USER_OK" = 1 ] || { adduser -S -D -H -h "$USER_HOME" -s "$USER_SHELL" "$USER_NAME" >/dev/null 2>&1 && user_exists && USER_OK=1; }
[ "$USER_OK" = 1 ] || { useradd -r -M -s "$USER_SHELL" "$USER_NAME" >/dev/null 2>&1 && user_exists && USER_OK=1; }

if [ ! -f /opt/etc/teleproxy/config.toml ]; then
    if [ -f /opt/share/teleproxy/config.toml.example ]; then
        cp /opt/share/teleproxy/config.toml.example /opt/etc/teleproxy/config.toml
        echo "[teleproxy] создан /opt/etc/teleproxy/config.toml — впишите свои секреты"
    fi
else
    echo "[teleproxy] существующий config.toml сохранён"
fi

if [ "$USER_OK" = 1 ]; then
    chown root:"$USER_NAME" /opt/etc/teleproxy/config.toml 2>/dev/null || true
    chmod 640 /opt/etc/teleproxy/config.toml
    echo "[teleproxy] пользователь $USER_NAME: uid=$(id -u "$USER_NAME")"
else
    chmod 644 /opt/etc/teleproxy/config.toml
    echo "[teleproxy] ВНИМАНИЕ: пользователя $USER_NAME создать не удалось (нет доступа к /etc/passwd?)"
    echo "[teleproxy]   P5 по uid работать не будет; поставьте user = \"root\" в конфиге"
fi

# --- P5 в Susanin ------------------------------------------------------------
SC=/opt/susanin/etc/susanin.conf
P5_CHANGED=0
if [ -f "$SC" ] && [ "$USER_OK" = 1 ]; then
    if ! grep -q '^proxy_uid=' "$SC" 2>/dev/null; then
        cat >> "$SC" <<EOF

# P5: трафик прокси на роутере -> туннель (добавлено postinst teleproxy)
proxy_uid=${USER_NAME}
proxy_egress=nwg0
proxy_table=110
proxy_mark=0x01000000
EOF
        echo "[teleproxy] в susanin.conf добавлены proxy_uid/proxy_egress"
        P5_CHANGED=1
    fi
    # Перезапуск нужен и когда ключи уже были: без пользователя правило метки
    # не создалось, и backend_ready должен перепровижнить датаплейн.
    if [ -x /opt/susanin/tools/susanin.sh ]; then
        /opt/susanin/tools/susanin.sh restart >/dev/null 2>&1 || true
        echo "[teleproxy] susanin перезапущен (правило метки пересоздано)"
    fi
elif [ -f "$SC" ]; then
    echo "[teleproxy] Susanin есть, но пользователь не создан — P5 не настраиваю"
else
    echo "[teleproxy] Susanin не найден — ключи P5 добавьте сами:"
    echo "[teleproxy]   proxy_uid=${USER_NAME} / proxy_egress=nwg0 / proxy_table=110"
fi

# --- проброс порта 8443 ------------------------------------------------------
if [ -x /opt/etc/init.d/S98teleproxy-fw ]; then
    /opt/etc/init.d/S98teleproxy-fw start || \
        echo "[teleproxy] ВНИМАНИЕ: проброс 8443 не встал (нет WAN?)"
fi

echo "[teleproxy] проверка:"
echo "  susanin check | grep proxy_egress     (ждём mark_rules=1)"
echo "  iptables -t nat -S PREROUTING | grep 8443"

# --- запуск службы -----------------------------------------------------------
if [ -x /opt/etc/init.d/S99teleproxy ]; then
    /opt/etc/init.d/S99teleproxy restart >/dev/null 2>&1 || \
        /opt/etc/init.d/S99teleproxy start >/dev/null 2>&1 || true
    echo "[teleproxy] служба запущена: /opt/etc/init.d/S99teleproxy status"
fi
exit 0
