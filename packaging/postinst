#!/bin/sh
# postinst — установка «под ключ», без ручных шагов на роутере.
#
# Ключевой момент Keenetic: /etc/passwd обычно read-only, поэтому пользователя
# teleproxy создать нельзя. Тогда работаем по ЧИСЛОВОМУ uid: teleproxy умеет
# `user = "1001"`, а iptables понимает `--uid-owner 1001` без записи в passwd.
set -e

USER_NAME=teleproxy
USER_SHELL=/sbin/nologin
USER_HOME=/opt/var/empty
BASE_UID=1001

user_exists() { id -u "$USER_NAME" >/dev/null 2>&1; }

add_via_passwd() {
    [ -w /etc/passwd ] || return 1
    _uid=$BASE_UID
    while awk -F: -v u="$_uid" '$3==u {found=1} END {exit !found}' /etc/passwd 2>/dev/null; do
        _uid=$((_uid + 1))
    done
    grep -q "^${USER_NAME}:" /etc/passwd 2>/dev/null || \
        echo "${USER_NAME}:x:${_uid}:${_uid}::${USER_HOME}:${USER_SHELL}" >> /etc/passwd
    grep -q "^${USER_NAME}:" /etc/group 2>/dev/null || \
        echo "${USER_NAME}:x:${_uid}:" >> /etc/group
    user_exists
}

mkdir -p /opt/etc/teleproxy /opt/var/log /opt/var/run "$USER_HOME"

# --- 1. идентификатор процесса ----------------------------------------------
MODE=name
if user_exists; then
    PROXY_ID=$(id -u "$USER_NAME")
else
    add_via_passwd && PROXY_ID=$(id -u "$USER_NAME" 2>/dev/null) && [ -n "$PROXY_ID" ] && MODE=name
fi
if [ "$MODE" = name ] && [ -z "$PROXY_ID" ]; then
    MODE=name
fi

if [ "$MODE" != name ] || ! user_exists; then
    # passwd недоступен — числовой uid, пользователя создавать не нужно
    MODE=numeric
    PROXY_ID=$BASE_UID
    while id -u "$PROXY_ID" >/dev/null 2>&1; do
        PROXY_ID=$((PROXY_ID + 1))
    done
fi

echo "[teleproxy] идентификатор: $PROXY_ID (режим: $MODE)"

# --- 2. конфиг и права -------------------------------------------------------
if [ ! -f /opt/etc/teleproxy/config.toml ]; then
    if [ -f /opt/share/teleproxy/config.toml.example ]; then
        cp /opt/share/teleproxy/config.toml.example /opt/etc/teleproxy/config.toml
        echo "[teleproxy] создан /opt/etc/teleproxy/config.toml — впишите свои секреты"
    fi
else
    echo "[teleproxy] существующий config.toml сохранён"
fi

# user в конфиге: имя, если пользователь есть, иначе число
if grep -q '^user[[:space:]]*=' /opt/etc/teleproxy/config.toml 2>/dev/null; then
    sed -i "s|^user[[:space:]]*=.*|user = \"${PROXY_ID}\"|" /opt/etc/teleproxy/config.toml
else
    printf '\nuser = "%s"\n' "${PROXY_ID}" >> /opt/etc/teleproxy/config.toml
fi
chown root:"${PROXY_ID}" /opt/etc/teleproxy/config.toml 2>/dev/null || true
chmod 640 /opt/etc/teleproxy/config.toml
echo "[teleproxy] config.toml: user = \"${PROXY_ID}\""

# --- 2b. оптимальные параметры «из коробки» ----------------------------------
# Значения подобраны на Keenetic Viva (124 МБ): 4 МБ пула буферов исчерпывались,
# 16 МБ давали kswapd/OOM, mss_clamp на PPPoE мешал. init-скрипт S99teleproxy
# задаёт --msg-buffers-size 10485760 (5 чанков по 2 МБ), --connections 128,
# --max-special-connections 32; здесь дописываем то, что живёт в config.toml,
# чтобы после установки ничего не приходилось править руками.
CFG=/opt/etc/teleproxy/config.toml

# top-level ключ обязан стоять ДО первого [[secret]]: после заголовка таблицы
# TOML относит его к этой таблице, и парсер его не видит.
toml_insert_before_secret() { # $1 = готов строкой "key = value"
    awk -v line="$1" '!done && /^\[\[secret\]\]/ { print line; print ""; done = 1 } { print }' \
        "$CFG" > "$CFG.new" && mv -f "$CFG.new" "$CFG"
}

ensure_toml() { # $1 = ключ, $2 = значение как есть (false / 32)
    if grep -q "^[[:space:]]*$1[[:space:]]*=" "$CFG" 2>/dev/null; then
        return 0
    fi
    toml_insert_before_secret "$1 = $2"
    # [[secret]] ещё нет — вставлять некуда, пишем в конец
    grep -q "^[[:space:]]*$1[[:space:]]*=" "$CFG" 2>/dev/null || \
        printf '\n%s = %s\n' "$1" "$2" >> "$CFG"
    echo "[teleproxy] config.toml: добавлено $1 = $2"
}

# Секрета в свежем конфиге может не быть вовсе (пример без [[secret]]):
# тогда шапка не нужна, ensure_toml просто допишет ключи в конец.
ensure_toml mss_clamp false
ensure_toml max_connections 32

# Старое значение могло остаться от прежних версий (было 256/512): общий лимит
# всё равно берётся из --connections, но пусть TOML не вводит в заблуждение.
if grep -q '^[[:space:]]*max_connections[[:space:]]*=[[:space:]]*[0-9]' "$CFG" 2>/dev/null; then
    sed -i 's|^[[:space:]]*max_connections[[:space:]]*=.*|max_connections = 32|' "$CFG"
fi

# --- 3. P5 в Susanin ---------------------------------------------------------
SC=/opt/susanin/etc/susanin.conf
if [ -f "$SC" ]; then
    if grep -q '^proxy_uid=' "$SC" 2>/dev/null; then
        sed -i "s|^proxy_uid=.*|proxy_uid=${PROXY_ID}|" "$SC"
    else
        cat >> "$SC" <<EOF

# P5: трафик прокси на роутере -> туннель (добавлено postinst teleproxy)
proxy_uid=${PROXY_ID}
proxy_egress=nwg0
proxy_table=110
proxy_mark=0x01000000
EOF
    fi
    grep -q '^proxy_egress=' "$SC" 2>/dev/null || echo "proxy_egress=nwg0" >> "$SC"
    echo "[teleproxy] susanin.conf: proxy_uid=${PROXY_ID}, proxy_egress=nwg0"
    if [ -x /opt/susanin/tools/susanin.sh ]; then
        /opt/susanin/tools/susanin.sh restart >/dev/null 2>&1 || true
        echo "[teleproxy] susanin перезапущен (правило метки пересоздано)"
    fi
else
    echo "[teleproxy] Susanin не найден — ключи P5 добавьте сами:"
    echo "[teleproxy]   proxy_uid=${PROXY_ID} / proxy_egress=nwg0 / proxy_table=110"
fi

# --- выбор апстрима: Xray SOCKS (Reality) или P5 через WireGuard --------------
# Если Xray слушает локальный SOCKS 127.0.0.1:1080, гоняем MTProto по Reality:
# это единственный канал, который не душат. P5 в этом случае не нужен.
if netstat -ltn 2>/dev/null | grep -q '127\.0\.0\.1:1080'; then
    if ! grep -q '^socks5[[:space:]]*=' /opt/etc/teleproxy/config.toml 2>/dev/null; then
        # ВАЖНО: ключ обязан быть ДО первого [[secret]] — после заголовка таблицы
        # TOML относит его к этой таблице, и парсер его не видит.
        # busybox sed не поддерживает адрес `0,/re/`, поэтому awk.
        awk '!done && /^\[\[secret\]\]/ {
                 print "socks5 = \"socks5://127.0.0.1:1080\"";
                 print "";
                 done = 1
             }
             { print }' /opt/etc/teleproxy/config.toml > /opt/etc/teleproxy/config.toml.new \
            && mv -f /opt/etc/teleproxy/config.toml.new /opt/etc/teleproxy/config.toml
        echo "[teleproxy] апстрим: Xray SOCKS 127.0.0.1:1080 (Reality)"
    else
        echo "[teleproxy] апстрим: Xray SOCKS (уже настроен)"
    fi
    if [ -f "$SC" ]; then
        sed -i 's/^proxy_uid=.*/proxy_uid=/; s/^proxy_egress=.*/proxy_egress=/' "$SC" 2>/dev/null || true
        echo "[teleproxy] P5 отключён (proxy_uid=), трафик идёт в Xray"
    fi
else
    echo "[teleproxy] Xray SOCKS не найден — апстрим через proxy_egress (nwg0)"
fi

# --- 4. проброс порта 8443 ---------------------------------------------------
if [ -x /opt/etc/init.d/S98teleproxy-fw ]; then
    /opt/etc/init.d/S98teleproxy-fw start || \
        echo "[teleproxy] ВНИМАНИЕ: проброс 8443 не встал (нет WAN?)"
fi

# --- 5. запуск службы --------------------------------------------------------
if [ -x /opt/etc/init.d/S99teleproxy ]; then
    /opt/etc/init.d/S99teleproxy restart >/dev/null 2>&1 || \
        /opt/etc/init.d/S99teleproxy start >/dev/null 2>&1 || true
    echo "[teleproxy] служба запущена"
fi

echo "[teleproxy] проверка:"
echo "  susanin check | grep proxy_egress     (ждём mark_rules=1)"
echo "  iptables -t mangle -S OUTPUT | grep uid-owner"
echo "  iptables -t nat -S PREROUTING | grep 8443"
echo "  ip route show table 110                        (ждём default dev nwg0)"
exit 0
